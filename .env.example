# Copia este archivo a `.env` y completa los valores. `.env` NO se versiona.
# Las 3 conexiones del proyecto. Valores por defecto de servidor/base entre paréntesis.

# 1) DW_RAW -> DW_Raw_v2 (+ dbriesgos)  (172.20.0.70)  autenticación SQL
DW_RAW_SERVER=172.20.0.70
DW_RAW_DATABASE=DW_Raw_v2
DW_RAW_USER=
DW_RAW_PASSWORD=

# 2) RCC -> DBRCC  (172.20.0.70)  autenticación SQL
RCC_SERVER=172.20.0.70
RCC_DATABASE=DBRCC
RCC_USER=
RCC_PASSWORD=

# 3) SLC -> slc (+ INTCOM, DWH, csd)  (172.24.2.213)
#    Autenticación de Windows si USER/PASSWORD quedan vacíos
SLC_SERVER=172.24.2.213
SLC_DATABASE=slc
SLC_USER=
SLC_PASSWORD=

# Opcionales
# DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# REPORTES_DIR_INPUTS=D:\FINANCIERA CONFIANZA\data\inputs
# REPORTES_DIR_OUTPUTS=D:\FINANCIERA CONFIANZA\data\outputs
