# Copia este archivo a `.env` y completa los valores. `.env` NO se versiona.
# El .env define SERVIDORES (3 conexiones). La BASE DE DATOS la elige cada reporte (base= en su ReporteLote,
# o su propio USE / nombres de 3 partes), por eso aquí no hay una base fija por conexión.
# Qué base vive en qué servidor: src/reportes/config.py (BASES_DE) y governance/docs/data/servidores-y-bases.md

# ----------------------------------------------------------------------------
# 1. MISH -> servidor MISHWBDDES01 (autenticación de Windows)
#    Bases que usan los reportes: storage (cartera, castigos, saldos, captaciones, seguros…), appj
# ----------------------------------------------------------------------------
MISH_SERVER=MISHWBDDES01
MISH_USER=
MISH_PASSWORD=

# ----------------------------------------------------------------------------
# 2. SLC -> servidor 172.24.2.213 (autenticación de Windows)
#    Bases que usan los reportes: dwh, dma, csd, intcom, slc
# ----------------------------------------------------------------------------
SLC_SERVER=172.24.2.213
SLC_USER=
SLC_PASSWORD=

# ----------------------------------------------------------------------------
# 3. RCC -> servidor 172.20.0.70 (autenticación SQL)
#    Bases que usan los reportes: dbriesgos, DBRCC, DW_Raw_v2, DW_Metadata, DB<AAAAMM>
# ----------------------------------------------------------------------------
RCC_SERVER=172.20.0.70
RCC_USER=
RCC_PASSWORD=

# ----------------------------------------------------------------------------
# FECHA DE CORTE (la escribes aquí y ejecutas los reportes cuando quieras)
# Formato AAAA-MM-DD. Prioridad: --fecha-corte en el comando > este .env > (solo diaria) día anterior, lunes = sábado.
# Mensual: último día del mes (si es feriado, el día hábil anterior). Vacío = sin definir.
# ----------------------------------------------------------------------------
FECHA_CORTE_DIARIA=
FECHA_CORTE_MENSUAL=

# ----------------------------------------------------------------------------
# CORREO (cuenta MIS) — reporte diario «cartera-sin-asignar»
# Flujo: 1) se envía una PRUEBA solo a CORREO_PRUEBA · 2) con tu conforme (--correo todos --conforme) se envía a la lista
#        data/inputs/correos_cartera_sin_asignar.txt y se avisa a Google Chat.
# La contraseña es una "contraseña de aplicación" de Gmail: SOLO aquí, nunca en el código ni en documentos.
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mis@confianza.pe
SMTP_PASSWORD=
MAIL_FROM_NAME=Sistemas de Información de Gestión
CORREO_PRUEBA=diego.sullcaray@confianza.pe
# LOGO_PATH=D:\FINANCIERA CONFIANZA\03 RECURSOS\logo.png
GOOGLE_CHAT_WEBHOOK_URL=
# CORREOS_SIN_ASIGNAR_ARCHIVO=D:\FINANCIERA CONFIANZA\...\correos.txt   (por defecto data/inputs/correos_cartera_sin_asignar.txt)

# Opcionales
# <PREFIJO>_DATABASE=...   catálogo inicial por defecto de ese servidor (la base del reporte siempre manda)
# DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# REPORTES_DIR_INPUTS=D:\FINANCIERA CONFIANZA\data\inputs
# REPORTES_DIR_OUTPUTS=D:\FINANCIERA CONFIANZA\data\outputs
